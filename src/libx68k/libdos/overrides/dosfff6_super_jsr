[lib]
/* 0xfff6 _SUPER_JSR: サブルーチンコール */
/* void _dos_super_jsr(void (*jobadr)(void), struct dos_dregs *inregs, struct dos_dregs *outregs); */

	.text
	.even
	.global _dos_super_jsr
	.type _dos_super_jsr, @function

_dos_super_jsr:
	movem.l	%d2-%d7/%a2-%a6, %sp@-
	move.l	%sp@(48), %sp@-
	movea.l	%sp@(56), %a0			| inregs
	movem.l	%a0@, %d0-%d7/%a0-%a6
	.short	0xfff6
	move.l	%a6, %sp@
	movea.l	%sp@(60), %a6			| outregs
	move.l	%sp@+, %a6@(56)
	movem.l	%d0-%d7/%a0-%a5, %a6@
	movem.l	%sp@+, %d2-%d7/%a2-%a6
	rts

[inline]
/* 0xfff6 _SUPER_JSR: サブルーチンコール */
static __inline__ void _dos_super_jsr(void (*jobadr)(void), struct dos_dregs *inregs, struct dos_dregs *outregs) {
    register void (*job)(void) __asm__("a1") = jobadr;
    register struct dos_dregs *in __asm__("a0") = inregs;
    register struct dos_dregs *out __asm__("a2") = outregs;
    __asm__ __volatile__ (
        "move.l %%a6,%%sp@-\n\t"
        "move.l %[out],%%sp@-\n\t"
        "move.l %[job],%%sp@-\n\t"
        "movem.l %%a0@,%%d0-%%d7/%%a0-%%a6\n\t"     // inregs
        ".short 0xfff6\n\t"
        "move.l %%a6,%%sp@\n\t"
        "move.l %%sp@(4),%%a6\n\t"
        "move.l %%sp@+,%%a6@(56)\n\t"
        "movem.l %%d0-%%d7/%%a0-%%a5,%%a6@\n\t"     // outregs
        "addq.l #4,%%sp\n\t"
        "move.l %%sp@+,%%a6\n\t"
        : [in]"+a"(in), [job]"+a"(job), [out]"+a"(out)
        :
        : "d0","d1","d2","d3","d4","d5","d6","d7",
          "a3","a4","a5","cc","memory");
    return;
}
